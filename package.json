{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run security:code && npm run qa:static && npm test",
    "security:code": "node scripts/secure-code-check.mjs",
    "security:deps": "npm audit --omit=dev --audit-level=high",
    "security": "npm run security:code && npm run security:deps",
    "security:deps:all": "npm audit --audit-level=high",
    "qa:static": "node scripts/qa-code-check.mjs",
    "qa:code": "npm run lint && npm run typecheck && npm run qa:static",
    "qa:product": "playwright test --config=playwright.config.mjs",
    "qa": "npm run qa:code && npm run qa:product"
  },
  "dependencies": {
    "@fontsource/alef": "^5.3.0",
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/david-libre": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
